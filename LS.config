#
# Target & Subtarget Configuration (目标架构配置)
#
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_jcg_q30=y

#
# Hardware Acceleration & Ethernet Drivers (硬件加速与千网卡驱动)
#
CONFIG_PACKAGE_kmod-mtk-eth-soc=y
CONFIG_PACKAGE_kmod-packet-socket=y

# 硬件转发/NAT加速 (HWNAT - 降低 CPU 占用，满血千兆必选)
CONFIG_PACKAGE_kmod-nat-hardware=y
CONFIG_PACKAGE_kmod-nat-hw-mediatek=y
CONFIG_PACKAGE_kmod-fast-classifier=y
CONFIG_PACKAGE_kmod-shortcut-fe=y

#
# Wireless Drivers & Firmware (无线驱动配置)
# 默认推荐开源 mac80211 驱动；若编译闭源驱动包，请按需选配 mt-wifi
#
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_kmod-mt76-connac=y
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-firmware=y
CONFIG_PACKAGE_wpad-openssl=y

# 避开/移除与 MTK 无关的无用无线固件以节省体积
# CONFIG_PACKAGE_kmod-ath9k is not set
# CONFIG_PACKAGE_kmod-rtl8192cu is not set

#
# CPU & Performance Tweaks (芯片与系统优化)
#
CONFIG_PACKAGE_kmod-crypto-hw-safexcel=y
CONFIG_PACKAGE_kmod-thermal=y

#
# Base Core & Storage Drivers (基础存储与文件系统驱动，用于刷机和日志)
#
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-mtdoops=y

#
# Basic LuCI UI & Translation (基础界面与中文语言包)
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

#
# Network Management Essentials (基础网络管理组件)
#
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
