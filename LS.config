# Target & Subtarget Configuration (目标平台)
#
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_jcg_q30=y

#
# Target Images (镜像生成格式控制 - 解决“少刷机文件”的核心配置)
#
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set

# 构建各种刷机格式文件 (Sysupgrade, Factory, FIT 镜像)
CONFIG_TARGET_UBIFS_FREE_SPACE_FIXUP=y
CONFIG_TARGET_MEDIATEK_FILOGIC_JCG_Q30_BUILD_FACTORY=y
CONFIG_TARGET_MEDIATEK_FILOGIC_JCG_Q30_BUILD_SYSUPGRADE=y

#
# 开源驱动及系统核心
#

CONFIG_PACKAGE_kmod-mt7976e=y
CONFIG_PACKAGE_kmod-mt7531=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-firmware=y
# CONFIG_PACKAGE_wpad-openssl=y

# 硬件加速与中继支持
CONFIG_PACKAGE_kmod-mtk-eth-soc=y
CONFIG_PACKAGE_kmod-nat-hardware=y
CONFIG_PACKAGE_kmod-nat-hw-mediatek=y
CONFIG_PACKAGE_kmod-shortcut-fe=y
CONFIG_PACKAGE_luci-proto-relay=y
CONFIG_PACKAGE_relayd=y

# 系统 UI 与基础组件
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
