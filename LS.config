#
# ==========================================================
# JCG Q30 / MT7981
# ImmortalWrt 24.10
# Extreme Minimal SSR Plus
# ==========================================================
#

#
# ==========================================================
# Target
# ==========================================================
#

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_jcg_q30=y


#
# ==========================================================
# Base system
# ==========================================================
#

CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_dropbear=y

CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_dnsmasq=y

CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_block-mount=y

CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_procd=y

CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_opkg=y


#
# ==========================================================
# LuCI
# ==========================================================
#

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

CONFIG_PACKAGE_luci-ssl=y

CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y


#
# ==========================================================
# IPv4
# ==========================================================
#

CONFIG_PACKAGE_ip-full=y


#
# ==========================================================
# IPv6
# ==========================================================
#

CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_luci-proto-ipv6=y


#
# ==========================================================
# MT7981 WiFi
# ==========================================================
#

CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-mt76=y
CONFIG_PACKAGE_kmod-mt7915e=y

#
# MT7981 firmware
#
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y


#
# ==========================================================
# WiFi firmware / wireless support
# ==========================================================
#

CONFIG_PACKAGE_wireless-regdb=y


#
# ==========================================================
# GPIO / LED / buttons
# ==========================================================
#

CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y


#
# ==========================================================
# TPROXY
# ==========================================================
#

CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_iptables-mod-tproxy=y

CONFIG_PACKAGE_kmod-nft-tproxy=y


#
# ==========================================================
# Netfilter
# ==========================================================
#

CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack6=y

CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-nat6=y


#
# ==========================================================
# TUN
# ==========================================================
#

CONFIG_PACKAGE_kmod-tun=y


#
# ==========================================================
# SSL / HTTPS
# ==========================================================
#

CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y

CONFIG_PACKAGE_libustream-openssl=y


#
# ==========================================================
# SSR Plus+
# ==========================================================
#

CONFIG_PACKAGE_luci-app-ssr-plus=y


#
# ==========================================================
# Xray
# ==========================================================
#

CONFIG_PACKAGE_xray-core=y


#
# ==========================================================
# V2Ray
# ==========================================================
#

CONFIG_PACKAGE_v2ray-core=y


#
# ==========================================================
# Trojan
# ==========================================================
#

CONFIG_PACKAGE_trojan=y


#
# ==========================================================
# Hysteria2
# ==========================================================
#

CONFIG_PACKAGE_hysteria=y


#
# ==========================================================
# Explicitly disable other proxy platforms
# ==========================================================
#

# PassWall
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set

# HomeProxy
# CONFIG_PACKAGE_luci-app-homeproxy is not set

# OpenClash
# CONFIG_PACKAGE_luci-app-openclash is not set

# sing-box
# CONFIG_PACKAGE_sing-box is not set

# Mihomo
# CONFIG_PACKAGE_mihomo is not set

# MosDNS
# CONFIG_PACKAGE_mosdns is not set
# CONFIG_PACKAGE_mosdns-v5 is not set
# CONFIG_PACKAGE_luci-app-mosdns is not set

# SmartDNS
# CONFIG_PACKAGE_smartdns is not set
# CONFIG_PACKAGE_luci-app-smartdns is not set

# Kcptun
# CONFIG_PACKAGE_kcptun-client is not set
# CONFIG_PACKAGE_kcptun-server is not set


#
# ==========================================================
# No Shadowsocks components
# ==========================================================
#

# CONFIG_PACKAGE_shadowsocks-libev-ss-local is not set
# CONFIG_PACKAGE_shadowsocks-libev-ss-redir is not set
# CONFIG_PACKAGE_shadowsocks-libev-ss-server is not set

# CONFIG_PACKAGE_shadowsocksr-libev-ss-local is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ss-redir is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ss-server is not set


#
# ==========================================================
# No NAS
# ==========================================================
#

# CONFIG_PACKAGE_samba4-server is not set
# CONFIG_PACKAGE_samba4-libs is not set
# CONFIG_PACKAGE_samba4-utils is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set


#
# ==========================================================
# No aria2
# ==========================================================
#

# CONFIG_PACKAGE_aria2 is not set
# CONFIG_PACKAGE_luci-app-aria2 is not set


#
# ==========================================================
# No SQM / CAKE
# ==========================================================
#

# CONFIG_PACKAGE_kmod-sched-cake is not set
# CONFIG_PACKAGE_kmod-sched-core is not set
# CONFIG_PACKAGE_tc-full is not set
# CONFIG_PACKAGE_luci-app-sqm is not set


#
# ==========================================================
# No UPnP
# ==========================================================
#

# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_miniupnpd is not set


#
# ==========================================================
# No DLNA
# ==========================================================
#

# CONFIG_PACKAGE_luci-app-minidlna is not set
# CONFIG_PACKAGE_minidlna is not set


#
# ==========================================================
# No USB storage
# ==========================================================
#

# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_kmod-usb-storage-uas is not set


#
# ==========================================================
# No extra filesystem tools
# ==========================================================
#

# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_kmod-fs-vfat is not set
# CONFIG_PACKAGE_kmod-fs-exfat is not set

# CONFIG_PACKAGE_e2fsprogs is not set
# CONFIG_PACKAGE_mkfs-ext4 is not set

# CONFIG_PACKAGE_fdisk is not set
# CONFIG_PACKAGE_mount-utils is not set


#
# ==========================================================
# No Bash / extra utilities
# ==========================================================
#

# CONFIG_PACKAGE_bash is not set
# CONFIG_PACKAGE_gawk is not set
# CONFIG_PACKAGE_coreutils is not set
# CONFIG_PACKAGE_coreutils-base64 is not set

# CONFIG_PACKAGE_htop is not set
# CONFIG_PACKAGE_procps-ng is not set


#
# ==========================================================
# No OpenSSH
# ==========================================================
#

# CONFIG_PACKAGE_openssh-client is not set
# CONFIG_PACKAGE_openssh-server is not set
# CONFIG_PACKAGE_openssh-sftp-server is not set


#
# ==========================================================
# No extra LuCI applications
# ==========================================================
#

# CONFIG_PACKAGE_luci-app-commands is not set
# CONFIG_PACKAGE_luci-app-package-manager is not set
# CONFIG_PACKAGE_luci-app-opkg is not set
# CONFIG_PACKAGE_luci-app-statistics is not set
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-app-watchcat is not set
# CONFIG_PACKAGE_luci-app-attendedsysupgrade is not set


#
# ==========================================================
# No AdGuard
# ==========================================================
#

# CONFIG_PACKAGE_adguardhome is not set
# CONFIG_PACKAGE_luci-app-adguardhome is not set


#
# ==========================================================
# Root filesystem
# ==========================================================
#

CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256


#
# ==========================================================
# Build system
# ==========================================================
#

# CONFIG_DEVEL is not set
# CONFIG_CCACHE is not set
