CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_zte_e8820s=y

# =========================================================
# 2. 基础系统与 Web 界面 (LuCI)
# =========================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# =========================================================
# 3. MTK 闭源驱动及其专属 LuCI 管理界面 (核心组件)
# 只有选中 luci-app-mtwifi，才会出现图片中完全一致的高级设置界面
# =========================================================
CONFIG_PACKAGE_kmod-mt7603e=y
CONFIG_PACKAGE_kmod-mt7615e=y
CONFIG_PACKAGE_luci-app-mtwifi=y

# 闭源无线依赖与实用工具
CONFIG_PACKAGE_mt_wifi=y
CONFIG_PACKAGE_dat2config=y

# =========================================================
# 4. 基础系统与命令行支持
# =========================================================
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_uci=y

# =========================================================
# 5. 精简多余第三方插件（保持固件清爽）
# =========================================================
# CONFIG_PACKAGE_usteer is not set
# CONFIG_PACKAGE_dawn is not set

# 广告拦截
CONFIG_PACKAGE_adbyby=n
CONFIG_PACKAGE_luci-app-adbyby-plus=n
CONFIG_PACKAGE_luci-i18n-adbyby-plus-zh-cn=n

CONFIG_PACKAGE_luci-app-filetransfer=n
# 内存释放
CONFIG_PACKAGE_luci-app-ramfree=n

CONFIG_PACKAGE_terminfo=n
# CPU 频率调节和 CPU 限制应用
CONFIG_PACKAGE_luci-app-cpulimit=n


# 网络加速器
CONFIG_PACKAGE_luci-app-turboacc=n
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=n

CONFIG_PACKAGE_htop=n
CONFIG_PACKAGE_automount=n
CONFIG_PACKAGE_openssh-sftp-server=n

# 防出错IPV6
CONFIG_PACKAGE_odhcpd-ipv6only=n
CONFIG_PACKAGE_odhcpd=n

CONFIG_PACKAGE_luci-app-serverchan=n
CONFIG_PACKAGE_luci-theme-material=n
CONFIG_PACKAGE_luci-app-sqm=n
CONFIG_PACKAGE_luci-app-eqos=n

# 管理 ARP 绑定IP绑定
CONFIG_PACKAGE_luci-app-arpbind=n
# 上网时间控制
CONFIG_PACKAGE_luci-app-accesscontrol=n

CONFIG_PACKAGE_luci-app-adbyby-plus=n
CONFIG_PACKAGE_luci-app-unblockmusic=n
CONFIG_PACKAGE_luci-app-vlmcsd=n
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_luci-app-wol=n

CONFIG_PACKAGE_luci-app-vsftpd=n
CONFIG_PACKAGE_luci-app-zerotier=n
CONFIG_PACKAGE_luci-app-upnp=n

CONFIG_PACKAGE_luci-app-firewall=n
CONFIG_PACKAGE_luci-app-nlbwmon=n
CONFIG_PACKAGE_luci-app-ramfree=n
CONFIG_PACKAGE_luci-app-ttyd=n

# 必备性能加速 (MT CPU 必备) 
CONFIG_PACKAGE_kmod-tcp-bbr=y 
CONFIG_PACKAGE_kmod-nft-offload=y 
CONFIG_PACKAGE_kmod-ipt-offload=y  
# --- 强制性能调整 (优化内存管理)
# CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-cake=y  # 
CONFIG_PACKAGE_kmod-sched-core=y  # 

# SS+
CONFIG_PACKAGE_luci-app-ssr-plus=n  # 
# 核心协议引擎 (Xray 包含 VMess/VLESS/Trojan/SS) 
# CONFIG_PACKAGE_xray-core=y  # 
# CONFIG_PACKAGE_xray-geodata=y  # 
# Hysteria2 (独立核心) 
# CONFIG_PACKAGE_hysteria=y  # 
# CONFIG_PACKAGE_tuic-client=y  # 
# CONFIG_PACKAGE_ca-bundle=y   # 

# ===== IPv6 核心 =====
CONFIG_IPV6=y
CONFIG_KERNEL_IPV6=y

# ===== DHCPv6 + RA =====
CONFIG_PACKAGE_odhcp6c=y

# ===== 防火墙 =====
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_kmod-ip6tables=y

# ===== 内核支持 =====
CONFIG_PACKAGE_kmod-ipv6=y
CONFIG_PACKAGE_kmod-nf-conntrack6=y

# ===== PPP IPv6（宽带用）=====
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# ===== 可选：隧道支持 =====
CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_6rd=y
CONFIG_PACKAGE_ds-lite=y



# 工具
# CONFIG_PACKAGE_htop=y
# CONFIG_PACKAGE_iftop=y

# 精简，去掉 NAS/Docker
CONFIG_PACKAGE_samba4=n
CONFIG_PACKAGE_docker=n
CONFIG_PACKAGE_luci-app-dockerman=n




# 彻底禁用 wolfssl
CONFIG_PACKAGE_libwolfssl=n

# 用 mbedtls
CONFIG_PACKAGE_libmbedtls=y
CONFIG_PACKAGE_libustream-mbedtls=y

# curl 走 mbedtls
CONFIG_LIBCURL_MBEDTLS=y
# CONFIG_LIBCURL_WOLFSSL is not set

# 解压文件
CONFIG_PACKAGE_xz=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_liblzma=y

